# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing / coverage
/coverage
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.tox/
.nox/

# Next.js / misc frameworks (defensive)
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds & CRA artifacts
/build
**/build/
dist/
dist
frontend/build/

# Environment files (never commit secrets)
.env
.env.*
*.env
!.env.example
!**/.env.example

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dump.rdb

# System files
.DS_Store
Thumbs.db
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/
.python-version

# Development tools / platform local state
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac
# Keep .emergent/ in the repo (platform metadata). Do not delete on disk.
.vercel

# Data and databases
agenthub/agents/youtube/db
*.sqlite
*.sqlite3

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/
**/.cache/
frontend/node_modules/.cache/

# Local secrets / agent memory credentials (never commit)
memory/test_credentials.md

# Mobile development
android-sdk/
credentials.json
*.key
.credentials

# Root lockfile without a root package.json (frontend owns deps)
/package-lock.json

# Nested git config should not live in the app repo
.gitconfig
