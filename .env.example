# =============================================================================
# Skilleraa — environment template
# Copy into frontend/.env (REACT_APP_* only) and backend/.env (server secrets).
# Never commit real secrets. Never put SERVICE_ROLE / JWT / Razorpay secret in frontend.
# =============================================================================

# --- Frontend (CRA) — prefix REACT_APP_ is required ---
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
REACT_APP_BACKEND_URL=http://localhost:8000

# --- Backend — Mongo ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=skilleraa_db

# --- Backend — Supabase (server) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# --- Backend — HTTP ---
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Backend — Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR

# --- Backend — demo seed (keep false for beta/production) ---
SEED_DEMO_DATA=false
DEMO_STUDENT_EMAIL=student@skilleraa.com
DEMO_STUDENT_PASSWORD=Student@1234
DEMO_CLIENT_EMAIL=client@skilleraa.com
DEMO_CLIENT_PASSWORD=Client@1234
ADMIN_EMAIL=admin@skilleraa.com
ADMIN_PASSWORD=Admin@1234

# --- Backend — optional ---
APP_NAME=skilleraa
EMERGENT_LLM_KEY=

# --- Frontend / tooling (optional) ---
# ENABLE_HEALTH_CHECK=true
