# =============================================================================
# Skilleraa — environment template
# Frontend: only REACT_APP_*  |  Backend: Supabase + Razorpay secrets
# Never commit real secrets. Never put SERVICE_ROLE / JWT / Razorpay secret in frontend.
# MongoDB is NOT used.
# =============================================================================

# --- Frontend (CRA) ---
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
REACT_APP_BACKEND_URL=http://localhost:8000

# --- Backend — Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# --- Backend — HTTP ---
# Railway: set this Variable (no trailing slashes). Code also always merges production domains.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.skilleraa.com,https://skilleraa.com,https://skilleraa-2-0.vercel.app
LOG_LEVEL=INFO

# --- Backend — Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR

# --- Backend — optional ---
APP_NAME=skilleraa
EMERGENT_LLM_KEY=
