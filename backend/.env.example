# Backend secrets. Copy to backend/.env — never expose to the browser.
# On Railway: set these in the service Variables UI. PORT is provided by Railway.
# MongoDB is NOT used — Supabase Postgres is the database.

# Comma-separated frontend origins (production Vercel URL required in prod)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_CURRENCY=INR

APP_NAME=skilleraa
EMERGENT_LLM_KEY=
