# Frontend-only public env (CRA). Copy to frontend/.env for local dev.
# Production: set in Vercel Project → Environment Variables (and/or frontend/.env.production).
# This is CRA — use REACT_APP_* only in the browser. Never put SERVICE_ROLE or Google Client Secret here.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
REACT_APP_BACKEND_URL=http://localhost:8000
# Optional alias (wired via craco); prefer REACT_APP_BACKEND_URL
NEXT_PUBLIC_API_URL=http://localhost:8000
