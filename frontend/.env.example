# Frontend-only public env (CRA). Copy to frontend/.env
# Production (Vercel): set these in Project → Environment Variables (not NEXT_PUBLIC_*).
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Local: http://localhost:8000 | Production: https://skilleraa-20-production.up.railway.app
REACT_APP_BACKEND_URL=http://localhost:8000
